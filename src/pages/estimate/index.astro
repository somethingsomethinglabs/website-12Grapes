---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Estimator from '../../components/Estimator.svelte';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.svelte';
---

<BaseLayout
  title="Estimate | 12Grapes"
  description="Build an indicative estimate for proposed 12Grapes vineyard services in Gippsland."
>
  <main>
    <Header currentPath={Astro.url.pathname} client:load />
    <section class="page-hero estimate-hero">
      <p class="eyebrow">Indicative cost calculator</p>
      <h1>Put your vineyard into the picture.</h1>
      <p>Start with five acres, compare proposed services, and send the result as an expression of interest.</p>
    </section>
    <Estimator client:load />
    <Footer currentPath={Astro.url.pathname} />
  </main>
</BaseLayout>
