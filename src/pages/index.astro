---
import { ArrowDown, ArrowRight, ArrowUpRight } from 'phosphor-svelte';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.svelte';
import ServiceDetails from '../components/ServiceDetails.svelte';

const services = [
  { key: 'ground-management', number: '01', title: 'Ground management', copy: 'Mechanical undervine mowing and cultivation with herbicide-free options.' },
  { key: 'pruning-training', number: '02', title: 'Pruning & training', copy: 'Hands-on vine work to support structure, balance and productive growth.' },
  { key: 'canopy-management', number: '03', title: 'Canopy management', copy: 'Seasonal canopy work to improve access, airflow and fruit-zone conditions.' },
  { key: 'vineyard-maintenance', number: '04', title: 'Vineyard maintenance', copy: 'Practical support for vineyard upkeep, repairs and routine seasonal jobs.' },
  { key: 'irrigation-support', number: '05', title: 'Irrigation support', copy: 'On-ground help with irrigation checks, maintenance and vineyard water systems.' },
  { key: 'harvest-support', number: '06', title: 'Harvest support', copy: 'Extra capability when timing matters, including crop estimation and harvest work.' },
];
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const enquiryHref = (service: string) => `mailto:matmahlook@gmail.com?subject=${encodeURIComponent(`12Grapes enquiry - ${service}`)}&body=${encodeURIComponent(`Hi Mat,\n\nI would like to discuss ${service.toLowerCase()} for my vineyard.\n\nVineyard location:\nApproximate area:\nWhat I need help with:\n`)}`;
---

<BaseLayout>
  <main>
    <div class="hero-shell">
      <Header currentPath={Astro.url.pathname} base={base} client:load />
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">Vineyard services <span aria-hidden="true"></span> Gippsland, Victoria</p>
          <h1>Supporting Gippsland vineyards <em>all year round.</em></h1>
          <p class="hero-lede">
            Practical support, specialist machinery and herbicide-free options
            for the work beneath every vine.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#services">Explore our services <ArrowDown size={17} weight="bold" /></a>
            <a class="hero-text-link" href="#estimate" data-estimate-open>Ground-management estimate <ArrowRight size={21} weight="regular" /></a>
          </div>
        </div>

        <div class="hero-art" aria-label="A compact vineyard tractor with specialist undervine equipment in a Gippsland vineyard">
          <div class="hero-photo"></div>
          <img
            class="tractor-cutout"
            src={`${base}tractor-cutout.png`}
            alt="Green vineyard tractor fitted with dual-sided mechanical undervine equipment"
          />
          <div class="hero-equipment-note">
            <span>Specialist equipment</span>
            <strong>Mechanical undervine care</strong>
          </div>
        </div>
      </section>
    </div>

    <section class="home-section services-section" id="services">
      <header class="home-section-heading">
        <div>
          <p class="section-kicker">Vineyard services</p>
          <h2>Support for every season.</h2>
        </div>
        <p>From establishment through harvest, 12Grapes provides practical vineyard support across Gippsland.</p>
      </header>
      <div class="home-service-grid">
        {services.map((service) => (
          <article class="home-service-card">
            <span class="service-number">{service.number}</span>
            <div>
              <h3>{service.title}</h3>
              <p>{service.copy}</p>
            </div>
            <button type="button" class="service-card-trigger" data-service-open={service.key} aria-label={`Learn more about ${service.title}`}>
              <span class="service-card-arrow" aria-hidden="true"><ArrowUpRight size={16} weight="bold" /></span>
            </button>
          </article>
        ))}
      </div>
    </section>

    <section class="ground-section" id="ground-management">
      <div class="ground-image" role="img" aria-label="Specialist vineyard tractor and undervine mowing equipment">
        <span class="image-note">Mechanical care beneath the vine</span>
      </div>
      <div class="ground-copy">
        <p class="section-kicker section-kicker-light">Specialist ground management</p>
        <h2>Control weeds.<br />Keep herbicide out.</h2>
        <p class="ground-lede">A purpose-built, dual-sided system works beneath both sides of the row in one pass. It gives growers a practical mechanical option for cleaner undervine strips.</p>
        <div class="ground-points">
          <div><span>01</span><p>Undervine mowing and cultivation</p></div>
          <div><span>02</span><p>Weed, sucker and trash disruption</p></div>
          <div><span>03</span><p>Support for snail and weevil control</p></div>
        </div>
        <a class="line-link" href="#estimate" data-estimate-open data-estimate-service="weeding">Get a ground-management estimate <ArrowUpRight size={17} weight="bold" /></a>
      </div>
    </section>

    <section class="equipment-section" aria-label="Specialist equipment">
      <div class="equipment-intro">
        <p class="section-kicker">Specialist equipment</p>
        <h2>Built for the row.</h2>
        <p>A compact vineyard tractor and front-mounted system are selected for precision, visibility and efficient work in tight vineyard conditions.</p>
      </div>
      <div class="equipment-stats">
        <article><strong>Dual-sided</strong><span>Two undervine strips in one pass</span></article>
        <article><strong>Front-mounted</strong><span>Clear visibility around every vine</span></article>
        <article><strong>Multi-task ready</strong><span>Make more of each pass where practical</span></article>
      </div>
    </section>

    <section class="why-section">
      <div class="why-mark" aria-hidden="true">12</div>
      <div class="why-copy">
        <p class="section-kicker">Why 12Grapes?</p>
        <h2>Twelve grapes.<br />Twelve months.</h2>
        <p>The name reflects a simple belief. A successful harvest starts with consistent care throughout the year.</p>
        <a class="line-link line-link-dark" href={`${base}about/`}>Our story <ArrowRight size={18} weight="regular" /></a>
      </div>
    </section>

    <section class="contact-section" id="contact">
      <p class="section-kicker section-kicker-light">Work with 12Grapes</p>
      <h2>Tell us what your vineyard needs.</h2>
      <p>Based in Gippsland and building a practical service around local growers.</p>
      <div class="contact-actions">
        <a class="button button-primary" href={enquiryHref('vineyard services')}>Email Mat about your vineyard <ArrowUpRight size={17} weight="bold" /></a>
        <a class="contact-phone" href="tel:0427551508">0427 551 508</a>
      </div>
    </section>
    <Footer currentPath={Astro.url.pathname} base={base} />
    <ServiceDetails client:load />
  </main>
</BaseLayout>
