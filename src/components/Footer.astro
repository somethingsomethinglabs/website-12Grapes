---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<footer class="footer" id="footer">
  <div class="footer-inner">
    <div>
      <a class="brand footer-brand" href="/">
        <img class="brand-logo" src="/12grapes-logo.png" alt="12Grapes Vineyard Services" />
      </a>
      <p>Practical vineyard support and specialist ground management for Gippsland growers.</p>
    </div>
    <div class="footer-links">
      <a href="/#services">Services</a>
      <a href="/#ground-management">Ground management</a>
      <a href="/about" aria-current={currentPath === '/about' ? 'page' : undefined}>About 12Grapes</a>
      <a href="#estimate" data-estimate-open>Request a quote</a>
      <a href="tel:0427551508">0427 551 508</a>
      <a href="mailto:matmahlook@gmail.com">matmahlook@gmail.com</a>
    </div>
  </div>
  <div class="footer-bottom">
    <span>12Grapes · Gippsland, Victoria</span>
    <span>Supporting Gippsland vineyards all year round.</span>
  </div>
</footer>
