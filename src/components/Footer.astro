---
interface Props {
  currentPath: string;
  base: string;
}

const { currentPath, base } = Astro.props;
const isAbout = currentPath.replace(/\/$/, '') === `${base}about`.replace(/\/$/, '');
---

<footer class="footer" id="footer">
  <div class="footer-inner">
    <div>
      <a class="brand footer-brand" href={base}>
        <img class="brand-logo" src={`${base}12grapes-logo.png`} alt="12Grapes Vineyard Services" />
      </a>
      <p>Practical vineyard support and specialist ground management for Gippsland growers.</p>
    </div>
    <div class="footer-links">
      <a href={`${base}#services`}>Services</a>
      <a href={`${base}#ground-management`}>Ground management</a>
      <a href={`${base}about/`} aria-current={isAbout ? 'page' : undefined}>About 12Grapes</a>
      <a href="#estimate" data-estimate-open>Request a quote</a>
      <a href="tel:0427551508">0427 551 508</a>
      <a href="mailto:matmahlook@gmail.com">matmahlook@gmail.com</a>
    </div>
  </div>
  <div class="footer-bottom">
    <span>12Grapes · Gippsland, Victoria</span>
    <span>Supporting Gippsland vineyards all year round.</span>
  </div>
</footer>
